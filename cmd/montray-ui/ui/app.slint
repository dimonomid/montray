import { HorizontalBox, Palette, ScrollView, VerticalBox } from "std-widgets.slint";
import "DepartureMono-Regular.otf";

export struct ServerView {
    id: string,
    connection: string,
    last-heartbeat: string,
    connected: bool,
    heartbeat-warning: bool,
    heartbeat-overdue: bool,
}

export struct IncidentView {
    key: string,
    state: string,
    details: string,
    started-at: string,
    snoozed-until: string,
    severity: int,
    stale: bool,
    snoozed: bool,
}

component SectionHeading inherits HorizontalLayout {
    in property <string> label;
    in property <bool> expanded;
    in property <brush> label-color;
    callback toggled();

    spacing: 8px;
    Rectangle {
        height: heading.preferred-height;
        width: heading.preferred-width + 8px;
        heading := Text {
            x: 4px;
            text: "▪ " + root.label + (root.expanded ? " ▼" : " ▲");
            color: root.label-color;
            vertical-alignment: center;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggled(); }
        }
    }
    Rectangle { horizontal-stretch: 1; }
}

component FieldRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <brush> foreground;
    spacing: 8px;
    Rectangle {
        width: 115px;
        min-height: primary.preferred-height;
        primary := Text {
            width: parent.width - 1px;
            text: root.label + ":";
            color: root.foreground;
            font-weight: 700;
            horizontal-alignment: right;
        }
        Text {
            x: 1px;
            width: parent.width - 1px;
            text: root.label + ":";
            color: root.foreground;
            font-weight: 700;
            horizontal-alignment: right;
        }
    }
    TextInput {
        text: root.value;
        color: root.foreground;
        read-only: true;
        single-line: false;
        wrap: word-wrap;
        horizontal-stretch: 1;
        // Some Linux backends still deliver middle-click primary-selection
        // paste to a read-only TextInput. Restore the model value immediately.
        edited => { self.text = root.value; }
    }
}

component PixelButton inherits Rectangle {
    in property <string> text;
    in property <string> accessible-text: text;
    in property <bool> dark-theme;
    callback clicked();

    min-width: label.preferred-width + 16px;
    preferred-width: label.preferred-width + 16px;
    max-width: label.preferred-width + 16px;
    horizontal-stretch: 0;
    min-height: label.preferred-height + 6px;
    preferred-height: label.preferred-height + 6px;
    max-height: label.preferred-height + 6px;
    vertical-stretch: 0;
    background: touch.pressed
        ? (dark-theme ? #484848 : #c6c6c6)
        : touch.has-hover
            ? (dark-theme ? #353535 : #d8d8d8)
            : (dark-theme ? #2a2a2a : #e5e5e5);
    border-color: focus-scope.has-focus
        ? (dark-theme ? #e8e8e8 : #000000)
        : (dark-theme ? #666666 : #777777);
    border-width: 1px;
    border-radius: 1px;
    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.accessible-text;
    accessible-action-default => { root.clicked(); }

    label := Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.text;
        color: root.dark-theme ? #e8e8e8 : #000000;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    focus-scope := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus-scope.focus();
            root.clicked();
        }
    }
}

component SnoozeButton inherits Rectangle {
    in property <bool> dark-theme;
    callback selected(string);

    min-width: button.preferred-width;
    preferred-width: button.preferred-width;
    max-width: button.preferred-width;
    min-height: button.preferred-height;
    preferred-height: button.preferred-height;
    max-height: button.preferred-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    button := PixelButton {
        width: parent.width;
        height: parent.height;
        text: "Snooze";
        dark-theme: root.dark-theme;
        clicked => { duration-popup.show(); }
    }

    duration-popup := PopupWindow {
        x: button.width;
        y: 0px;
        width: options.preferred-width;
        height: options.preferred-height;
        close-policy: close-on-click-outside;

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: root.dark-theme ? #2a2a2a : #e5e5e5;
            border-color: root.dark-theme ? #666666 : #777777;
            border-width: 1px;
        }
        options := HorizontalLayout {
            width: parent.width;
            height: parent.height;
            padding: 5px;
            spacing: 5px;
            for duration in ["15m", "30m", "1h", "4h", "6h", "12h", "1d", "2d", "7d"]: PixelButton {
                text: duration;
                accessible-text: "Snooze for " + duration;
                dark-theme: root.dark-theme;
                clicked => {
                    root.selected(duration);
                    duration-popup.close();
                }
            }
        }
    }
}

// Departure Mono ships as a regular face only. Overprinting it by one pixel
// gives headings the same faux-bold treatment browsers apply to the old UI.
component TableHeaderText inherits Rectangle {
    in property <string> text;
    in property <brush> text-color;

    min-height: primary.preferred-height;
    primary := Text {
        width: parent.width - 1px;
        text: root.text;
        color: root.text-color;
        font-weight: 700;
        wrap: word-wrap;
    }
    Text {
        x: 1px;
        width: parent.width - 1px;
        text: root.text;
        color: root.text-color;
        font-weight: 700;
        wrap: word-wrap;
    }
}

component IncidentCard inherits VerticalLayout {
    in property <IncidentView> incident;
    in property <brush> foreground-color;
    in property <brush> disconnected-color;
    in property <brush> warning-color;
    in property <brush> stale-color;
    in property <bool> dark-theme;
    callback action(string, string);

    spacing: 8px;
    property <brush> text-color: incident.stale ? root.stale-color : root.foreground-color;

    Rectangle {
        min-height: fields.preferred-height;
        preferred-height: fields.preferred-height;
        max-height: fields.preferred-height;

        fields := VerticalLayout {
            width: parent.width;
            spacing: 4px;
            FieldRow { label: "key"; value: root.incident.key; foreground: root.text-color; }
            FieldRow { label: "state"; value: root.incident.state; foreground: root.text-color; }
            FieldRow { label: "details"; value: root.incident.details; foreground: root.text-color; }
            FieldRow { label: "started at"; value: root.incident.started-at; foreground: root.text-color; }
            if root.incident.snoozed: FieldRow {
                label: "snoozed until";
                value: root.incident.snoozed-until;
                foreground: root.text-color;
            }
        }

        Image {
            x: 0px;
            y: 0px;
            source: root.incident.severity == 4
                ? @image-url("../assets/tray/magenta.png")
                : root.incident.severity == 3
                    ? @image-url("../assets/tray/red.png")
                    : root.incident.severity == 1
                        ? @image-url("../assets/tray/green.png")
                        : @image-url("../assets/tray/yellow.png");
            width: 20px;
            height: 20px;
            image-fit: contain;
        }
    }

    HorizontalLayout {
        spacing: 8px;
        if root.incident.snoozed: PixelButton {
            text: "Unsnooze";
            dark-theme: root.dark-theme;
            clicked => { root.action("unsnooze", ""); }
        }
        if !root.incident.snoozed: SnoozeButton {
            dark-theme: root.dark-theme;
            selected(duration) => { root.action("snooze", duration); }
        }
        if root.incident.stale: PixelButton {
            text: "Forget stale";
            dark-theme: root.dark-theme;
            clicked => { root.action("forget", ""); }
        }
        Rectangle { horizontal-stretch: 1; }
    }

}

component IncidentSeparator inherits Rectangle {
    in property <brush> line-color;
    min-height: 1px;
    preferred-height: 1px;
    max-height: 1px;
    background: root.line-color;
}

export component MainWindow inherits Window {
    title: "Montray";
    icon: @image-url("../assets/app-icon.svg");
    default-font-family: "Departure Mono";
    // Slint's default is 12px. Increase body, table, incident, and control
    // typography somewhat.
    default-font-size: 13px;
    // Used only when persisted window geometry is unavailable.
    preferred-width: 765px;
    preferred-height: 500px;
    min-width: 260px;
    min-height: 180px;
    background: dark-theme ? #171717 : #ffffff;

    in-out property <bool> dark-theme: true;
    in-out property <bool> servers-expanded: true;
    in-out property <bool> active-incidents-expanded: true;
    in-out property <bool> snoozed-incidents-expanded: false;
    in property <[ServerView]> servers;
    in property <string> server-summary;
    in property <int> online-server-count;
    in property <image> current-tray-icon;
    in property <[IncidentView]> active-incidents;
    in property <[IncidentView]> snoozed-incidents;
    callback preferences-changed();
    callback incident-action(string, string, string);

    init => {
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-theme => {
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }

    property <brush> foreground-color: dark-theme ? #e8e8e8 : #000000;
    property <brush> border-color-value: dark-theme ? #666666 : #777777;
    property <brush> connected-color: dark-theme ? #7ad879 : #008000;
    property <brush> disconnected-color: dark-theme ? #ff7b72 : #ff0000;
    property <brush> warning-color: dark-theme ? #f1c453 : #b8860b;
    property <brush> stale-color: dark-theme ? #999999 : #666666;
    property <brush> surface-color: dark-theme ? #2a2a2a : #e5e5e5;
    property <length> server-id-column-width: min(160px, max(60px, (self.width - 68px) * 0.4));
    property <length> server-connection-column-width: min(120px, max(64px, (self.width - 68px) * 0.3));

    ScrollView {
        // Layouts and text shrink/wrap first. Once the content reaches its
        // intrinsic minimum width, any remaining overflow becomes scrollable.
        viewport-width: max(self.visible-width, content.min-width);
        content := VerticalBox {
            padding-left: 22px;
            padding-right: 22px;
            padding-bottom: 22px;
            spacing: 0px;
            // Keep every section at its preferred height. Any viewport space
            // left over belongs below the content instead of being distributed
            // among the rows by the layout's default stretch alignment.
            alignment: start;

            HorizontalBox {
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: title-text.preferred-width + 1px;
                    min-height: title-text.preferred-height;
                    title-text := Text {
                        width: parent.width - 1px;
                        text: "♥ Montray";
                        color: root.foreground-color;
                        font-size: 26px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 1px;
                        width: parent.width - 1px;
                        text: "♥ Montray";
                        color: root.foreground-color;
                        font-size: 26px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                PixelButton {
                    text: root.dark-theme ? "☀" : "☾";
                    accessible-text: root.dark-theme ? "Switch to light scheme" : "Switch to dark scheme";
                    dark-theme: root.dark-theme;
                    clicked => {
                        root.dark-theme = !root.dark-theme;
                        root.preferences-changed();
                    }
                }
            }

            SectionHeading {
                label: root.server-summary;
                expanded: root.servers-expanded;
                label-color: root.online-server-count == root.servers.length
                    ? root.connected-color
                    : root.online-server-count == 0
                        ? root.disconnected-color
                        : root.warning-color;
                toggled => {
                    root.servers-expanded = !root.servers-expanded;
                    root.preferences-changed();
                }
            }
            if root.servers-expanded: VerticalLayout {
                spacing: 5px;
                HorizontalLayout {
                    spacing: 12px;
                    TableHeaderText { text: "server"; text-color: root.foreground-color; width: root.server-id-column-width; }
                    TableHeaderText { text: "connection"; text-color: root.foreground-color; width: root.server-connection-column-width; }
                    TableHeaderText { text: "last heartbeat"; text-color: root.foreground-color; horizontal-stretch: 1; }
                }
                for server in root.servers: HorizontalLayout {
                    spacing: 12px;
                    Text { text: server.id; color: root.foreground-color; width: root.server-id-column-width; wrap: char-wrap; }
                    Text { text: server.connection; color: server.connected ? root.connected-color : root.disconnected-color; width: root.server-connection-column-width; wrap: word-wrap; }
                    Text {
                        text: server.last-heartbeat;
                        color: server.heartbeat-overdue
                            ? root.disconnected-color
                            : server.heartbeat-warning
                                ? root.warning-color
                                : root.foreground-color;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                }
                Rectangle { height: 1px; background: root.border-color-value; }
            }

            SectionHeading {
                label: root.active-incidents.length == 1 ? "1 incident" : root.active-incidents.length + " incidents";
                expanded: root.active-incidents-expanded;
                label-color: root.active-incidents.length > 0 ? root.disconnected-color : root.connected-color;
                toggled => {
                    root.active-incidents-expanded = !root.active-incidents-expanded;
                    root.preferences-changed();
                }
            }
            if root.active-incidents-expanded: VerticalLayout {
                spacing: 10px;
                if root.active-incidents.length == 0: Text {
                    text: "No ongoing incidents.";
                    color: root.foreground-color;
                }
                for incident in root.active-incidents: VerticalLayout {
                    spacing: 8px;
                    IncidentCard {
                        incident: incident;
                        foreground-color: root.foreground-color;
                        disconnected-color: root.disconnected-color;
                        warning-color: root.warning-color;
                        stale-color: root.stale-color;
                        dark-theme: root.dark-theme;
                        action(action, argument) => { root.incident-action(incident.key, action, argument); }
                    }
                    IncidentSeparator { line-color: root.border-color-value; }
                }
            }

            SectionHeading {
                label: root.snoozed-incidents.length == 1 ? "1 snoozed incident" : root.snoozed-incidents.length + " snoozed incidents";
                expanded: root.snoozed-incidents-expanded;
                label-color: root.snoozed-incidents.length > 0 ? root.warning-color : root.connected-color;
                toggled => {
                    root.snoozed-incidents-expanded = !root.snoozed-incidents-expanded;
                    root.preferences-changed();
                }
            }
            if root.snoozed-incidents-expanded: VerticalLayout {
                spacing: 10px;
                if root.snoozed-incidents.length == 0: Text {
                    text: "No snoozed incidents.";
                    color: root.foreground-color;
                }
                for incident in root.snoozed-incidents: VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        min-height: card.preferred-height + 8px;
                        preferred-height: card.preferred-height + 8px;
                        max-height: card.preferred-height + 8px;
                        background: root.surface-color;
                        border-radius: 4px;

                        card := IncidentCard {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            incident: incident;
                            foreground-color: root.foreground-color;
                            disconnected-color: root.disconnected-color;
                            warning-color: root.warning-color;
                            stale-color: root.stale-color;
                            dark-theme: root.dark-theme;
                            action(action, argument) => { root.incident-action(incident.key, action, argument); }
                        }
                    }
                    IncidentSeparator { line-color: root.border-color-value; }
                }
            }
        }
    }

}

export component MontrayTray inherits SystemTrayIcon {
    // SystemTrayIcon creates its native backend while this component is being
    // constructed. It therefore needs a decodable icon before Rust can publish
    // the first runtime snapshot and replace it with the current status icon.
    in property <image> tray-icon: @image-url("../assets/tray/gray.png");
    in property <string> status-title;
    in property <bool> autostart-supported;
    in property <bool> autostart-enabled;
    callback toggle-window();
    callback open-window();
    callback example-notification();
    callback toggle-autostart();
    callback edit-configuration();
    callback restart();
    callback exit();

    icon: root.tray-icon;
    tooltip: "Montray";
    clicked => { root.toggle-window(); }

    Menu {
        MenuItem {
            title: root.status-title;
            activated => { root.open-window(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Example notification";
            activated => { root.example-notification(); }
        }
        MenuSeparator { }
        if root.autostart-supported: MenuItem {
            title: root.autostart-enabled ? "Disable autostart" : "Enable autostart";
            activated => { root.toggle-autostart(); }
        }
        MenuItem {
            title: "Edit configuration";
            activated => { root.edit-configuration(); }
        }
        MenuItem {
            title: "Restart and reload configuration";
            activated => { root.restart(); }
        }
        MenuItem {
            title: "Exit";
            activated => { root.exit(); }
        }
    }
}
